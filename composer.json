{
    "name": "isaachatilima/laracanon",
    "description": "An extensible development toolkit for installing Laravel conventions, integrations, rules, and workflows.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "development", "toolkit", "boost", "ai"],
    "homepage": "https://github.com/IsaacHatilima/laracanon",
    "support": {
        "issues": "https://github.com/IsaacHatilima/laracanon/issues",
        "source": "https://github.com/IsaacHatilima/laracanon"
    },
    "authors": [{"name": "Isaac Hatilima"}],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "nette/neon": "^3.4",
        "symfony/process": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^9.15|^10.6|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {"psr-4": {"Isaachatilima\\Laracanon\\": "src/"}},
    "autoload-dev": {"psr-4": {"Isaachatilima\\Laracanon\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Isaachatilima\\Laracanon\\LaracanonServiceProvider"]}},
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "check": ["@composer validate --strict", "@lint", "@test"]
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
